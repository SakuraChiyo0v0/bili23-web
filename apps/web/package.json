{
  "name": "@bili23-web/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "dev": "vite",
    "dev:client": "vite",
    "dev:all": "npm-run-all --parallel dev:server dev:client",
    "check:client": "tsc --noEmit -p tsconfig.client.json && vite build",
    "preview": "vite preview",
    "check": "npm-run-all typecheck test build check:client",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@bili23-web/engine": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
